{
  "name": "SKF to DXF",
  "short_name": "SKF to DXF",
  "description": "Convert AutoSketch drawings (.skf) to DXF for AutoCAD, without uploading your files.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f7f6f3",
  "theme_color": "#1f5fbf",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/octet-stream": [".skf"] } }
  ]
}
